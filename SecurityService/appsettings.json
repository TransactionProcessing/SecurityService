{
  "ServiceOptions": {
    "SeedDefaultScopes": false,
    "PublicOrigin": "https://127.0.0.1:5001",
    "DataProtectionKeyDirectory": "C:\\home\\txnproc\\keys",
    "IssuerUrl": "https://127.0.0.1:5001",
    "ClientId": "serviceClient",
    "PasswordOptions": {
      "RequiredLength": 6,
      "RequireDigit": true,
      "RequireUpperCase": true
    },
    "UserOptions": {
      "RequireUniqueEmail": true
    },
    "SignInOptions": {
      "RequireConfirmedEmail": true
    },
    "TokenOptions": {
      "EmailConfirmationTokenExpiryInHours": 48,
      "PasswordResetTokenExpiryInHours": 2
    },
    "OAuth": {
      "EnableLegacyGrantTypes": true,
      "LegacyGrantTypeClients": {
        "password": [
          "managementUIClient",
          "mobileAppClient"
        ],
        "hybrid": [
          "managementUIClient",
          "mobileAppClient"
        ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HealthMonitoring": {
    "Service": {
      "ServiceId": "security-service",
      "Name": "Security Service",
      "Description": "Security Service",
      "HealthUrl": "https://127.0.0.1:5001/healthui",
      "IgnoreCertificateErrors": false
    },
    "Dependencies": [
      {
        "DependencyName": "Messaging Service",
        "TargetServiceId": "messaging-service"
      },
      {
        "DependencyName": "database",
        "TargetServiceId": "sql-server"
      }
    ]
  }
}
